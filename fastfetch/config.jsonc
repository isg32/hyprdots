{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "type": "builtin",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "type": "string"
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 8
    },
    "percent": {
      "type": 3
    },
    "color": {
      "keys": "cyan",
      "title": "cyan",
      "separator": "90"
    },
    "size": {
      "binaryPrefix": "jedec"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "  {#1;36}{user-name}{#}{#90}@{#}{#1;35}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#90}┌─ {#1;35}system{#}"
    },
    {
      "type": "host",
      "key": "│   host    ",
      "format": "{name}"
    },
    {
      "type": "os",
      "key": "│   os      "
    },
    {
      "type": "kernel",
      "key": "│   kernel  "
    },
    {
      "type": "uptime",
      "key": "│   uptime  "
    },
    {
      "type": "packages",
      "key": "│   pkgs    "
    },
    {
      "type": "shell",
      "key": "│   shell   "
    },
    {
      "type": "custom",
      "format": "{#90}├─ {#1;35}desktop{#}"
    },
    {
      "type": "wm",
      "key": "│   wm      "
    },
    {
      "type": "terminal",
      "key": "│   term    "
    },
    {
      "type": "font",
      "key": "│   font    "
    },
    {
      "type": "cursor",
      "key": "│   cursor  "
    },
    {
      "type": "display",
      "key": "│   display "
    },
    {
      "type": "custom",
      "format": "{#90}├─ {#1;35}hardware{#}"
    },
    {
      "type": "cpu",
      "key": "│   cpu     ",
      "format": "{name} @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "│   gpu     ",
      "hideType": "discrete",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│ 󰍛  memory  ",
      "percent": {
        "type": [
          "bar",
          "num"
        ],
        "green": 40,
        "yellow": 70
      }
    },
    {
      "type": "swap",
      "key": "│ 󰍛  swap    "
    },
    {
      "type": "disk",
      "key": "│   disk    ",
      "percent": {
        "type": [
          "bar",
          "num"
        ],
        "green": 50,
        "yellow": 80
      },
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "battery",
      "key": "│   battery "
    },
    {
      "type": "localip",
      "key": "│   ip      "
    },
    {
      "type": "custom",
      "format": "{#90}└─{#}"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}